{% if "ci-cd" in features %}name: CI

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  test:
    runs-on: ubuntu-latest

    {% if database == "postgresql" %}
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: test_{{ project_name }}
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432
    {% elif database == "mysql" %}
    services:
      mysql:
        image: mysql:8
        env:
          MYSQL_ROOT_PASSWORD: root
          MYSQL_DATABASE: test_{{ project_name }}
        options: >-
          --health-cmd="mysqladmin ping"
          --health-interval=10s
          --health-timeout=5s
          --health-retries=5
        ports:
          - 3306:3306
    {% endif %}

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '{{ python_version }}'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]"

      {% if "testing" in features %}
      - name: Run tests
        run: pytest --cov=src tests/
        {% if database == "postgresql" %}
        env:
          DATABASE_URL: postgresql://postgres:postgres@localhost:5432/test_{{ project_name }}
        {% elif database == "mysql" %}
        env:
          DATABASE_URL: mysql+pymysql://root:root@localhost:3306/test_{{ project_name }}
        {% endif %}
      {% endif %}

      - name: Lint with ruff
        run: ruff check .
{% endif %}
